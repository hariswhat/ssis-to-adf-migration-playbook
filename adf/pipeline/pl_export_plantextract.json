{
  "name": "pl_export_plantextract",
  "properties": {
    "description": "Runs SSIS package Export_PlantExtract unchanged on the Azure-SSIS IR until it is rewritten (docs/adr/0001).",
    "activities": [
      {
        "name": "Run Export_PlantExtract",
        "type": "ExecuteSSISPackage",
        "dependsOn": [],
        "policy": {
          "timeout": "0.02:00:00",
          "retry": 0
        },
        "typeProperties": {
          "packageLocation": {
            "type": "SSISDB",
            "packagePath": "NorthgateETL/NorthgateETL/Export_PlantExtract.dtsx"
          },
          "runtime": "x64",
          "loggingLevel": "Basic",
          "projectParameters": {
            "DW_ConnectionString": {
              "value": "Data Source=sql-ngbp-dw-dev.database.windows.net;Initial Catalog=NorthgateDW;Provider=MSOLEDBSQL.1;"
            }
          },
          "propertyOverrides": {
            "\\Package.Connections[DW].Properties[ConnectUsingManagedIdentity]": {
              "value": "True",
              "isSensitive": false
            }
          },
          "connectVia": {
            "referenceName": "ir-azure-ssis",
            "type": "IntegrationRuntimeReference"
          }
        }
      }
    ],
    "parameters": {
      "run_time": {
        "type": "string",
        "defaultValue": ""
      }
    },
    "annotations": [
      "azure-ssis-ir"
    ]
  }
}
