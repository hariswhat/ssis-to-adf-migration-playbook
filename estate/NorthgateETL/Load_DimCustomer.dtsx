            </component>
            <component refId="Package\SCD customer\Expire current row" componentClassID="Microsoft.OLEDBCommand" name="Expire current row">
              <properties>
                <property name="SqlCommand">UPDATE dw.dim_customer SET valid_to = GETDATE(), is_current = 0 WHERE customer_code = ? AND is_current = 1</property>
              </properties>
              <connections>
                <connection refId="Package\SCD customer\Expire current row.Connections[OleDbConnection]" connectionManagerID="Package.ConnectionManagers[DW]" connectionManagerRefId="Package.ConnectionManagers[DW]" name="OleDbConnection" />
