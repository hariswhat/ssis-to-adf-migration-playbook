  <DTS:Variables>
    <DTS:Variable DTS:CreationName="" DTS:DTSID="{741FF1E8-B930-5048-8AA6-183AE74AC35C}" DTS:IncludeInDebugDump="2345" DTS:Namespace="User" DTS:ObjectName="LastWatermark">
      <DTS:VariableValue DTS:DataType="8">1900-01-01</DTS:VariableValue>
    </DTS:Variable>
    <DTS:Variable DTS:CreationName="" DTS:DTSID="{D158EB97-3C01-5B3E-8982-A55AA9F6DBE8}" DTS:IncludeInDebugDump="2345" DTS:Namespace="User" DTS:ObjectName="SourceQuery" DTS:EvaluateAsExpression="True" DTS:Expression="&quot;SELECT order_id, line_number, customer_code, product_code, order_date, quantity, unit_price, modified_at FROM dbo.order_line WHERE modified_at &gt; '&quot; + @[User::LastWatermark] + &quot;'&quot;">
      <DTS:VariableValue DTS:DataType="8"></DTS:VariableValue>
    </DTS:Variable>
    <DTS:Variable DTS:CreationName="" DTS:DTSID="{1E4EBC4C-3A21-5052-8984-7756143F73E3}" DTS:IncludeInDebugDump="2345" DTS:Namespace="User" DTS:ObjectName="RowsCopied">
      <DTS:VariableValue DTS:DataType="3">0</DTS:VariableValue>
    </DTS:Variable>
  </DTS:Variables>
  <DTS:Executables>
    <DTS:Executable DTS:refId="Package\Truncate stage" DTS:CreationName="Microsoft.ExecuteSQLTask" DTS:DTSID="{E84408FC-2AB1-5FC3-9453-C4B511B28D1F}" DTS:ExecutableType="Microsoft.ExecuteSQLTask" DTS:ObjectName="Truncate stage">
      <DTS:ObjectData>
        <SQLTask:SqlTaskData SQLTask:Connection="{B895158F-254A-5317-A8A8-AB07EBCE7EE1}" SQLTask:SqlStatementSource="TRUNCATE TABLE stg.order_line;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable DTS:refId="Package\Get watermark" DTS:CreationName="Microsoft.ExecuteSQLTask" DTS:DTSID="{7C09EB90-560C-5258-B088-376BCC72622E}" DTS:ExecutableType="Microsoft.ExecuteSQLTask" DTS:ObjectName="Get watermark">
      <DTS:ObjectData>
        <SQLTask:SqlTaskData SQLTask:Connection="{B895158F-254A-5317-A8A8-AB07EBCE7EE1}" SQLTask:SqlStatementSource="SELECT CONVERT(VARCHAR(23), MAX(watermark_at), 121) AS last_watermark FROM etl.watermark WHERE table_name = 'order_line'" SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ResultBinding SQLTask:ResultName="0" SQLTask:DtsVariableName="User::LastWatermark" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
