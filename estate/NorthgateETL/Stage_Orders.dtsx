    <DTS:Executable DTS:refId="Package\Set watermark" DTS:CreationName="Microsoft.ExecuteSQLTask" DTS:DTSID="{01A7D25B-FF8D-5CCC-9F7D-AA55C81D54E2}" DTS:ExecutableType="Microsoft.ExecuteSQLTask" DTS:ObjectName="Set watermark">
      <DTS:ObjectData>
        <SQLTask:SqlTaskData SQLTask:Connection="{B895158F-254A-5317-A8A8-AB07EBCE7EE1}" SQLTask:SqlStatementSource="UPDATE etl.watermark SET watermark_at = (SELECT MAX(modified_at) FROM stg.order_line) WHERE table_name = 'order_line';" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
