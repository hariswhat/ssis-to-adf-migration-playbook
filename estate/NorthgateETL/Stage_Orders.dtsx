            <path refId="Package\Copy new order lines.Paths[Count rows to stg order_line]" startId="Package\Copy new order lines\Count rows.Outputs[Output]" endId="Package\Copy new order lines\stg order_line.Inputs[Input]" name="Count rows to stg order_line" />
          </paths>
        </pipeline>
