          <ProjectItem Name="ScriptMain.cs" Encoding="UTF8"><![CDATA[
public void Main()
{
    // Builds the fixed-width extract the plant partner expects:
    // header record, one record per plant per day, trailer with a checksum.
    var path = Dts.Variables["User::ExtractFile"].Value.ToString();
    // ... 140 lines of string formatting and a custom mod-97 checksum ...
    Dts.TaskResult = (int)ScriptResults.Success;
}
]]></ProjectItem>
